          "expr": "sum(upsBasicOutputStatus{instance=~\"$instance\", upsBasicOutputStatus=\"onLine\"}) + 2 * sum(upsBasicOutputStatus{instance=~\"$instance\", upsBasicOutputStatus=\"onBattery\"}) + 3 * sum(upsBasicOutputStatus{instance=~\"$instance\", upsBasicOutputStatus=~\"onSmartBoost|onSmartTrim\"})",
          "instant": true,
          "refId": "A"
        }
      ]
