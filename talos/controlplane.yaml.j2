---
# Control-plane-only patch. NOTE: machine.ca / cluster.ca / aggregatorCA / etcd.ca
# each merge as a UNIT — crt must be repeated alongside key or the crt gets blanked.
# cluster.apiServer/controllerManager/scheduler/proxy/coreDNS/secretboxEncryptionSecret
# are deliberately still v1alpha1: moving them means KubeAPIServerConfig PLUS
# KubeAuthenticationConfig + KubeAuthorizerConfig node/rbac in one apply (next slice).
machine:
  type: controlplane
  ca:
    crt: op://k8s/talos/MACHINE_CA_CRT
    key: op://k8s/talos/MACHINE_CA_KEY
cluster:
  ca:
    crt: op://k8s/talos/CLUSTER_CA_CRT
    key: op://k8s/talos/CLUSTER_CA_KEY
  aggregatorCA:
    crt: op://k8s/talos/CLUSTER_AGGREGATORCA_CRT
    key: op://k8s/talos/CLUSTER_AGGREGATORCA_KEY
  serviceAccount:
    key: op://k8s/talos/CLUSTER_SERVICEACCOUNT_KEY
  secretboxEncryptionSecret: op://k8s/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
  apiServer:
    image: registry.k8s.io/kube-apiserver:{{ kubernetes_version }}
    certSANs:
      - "127.0.0.1"
      - "10.13.17.17"
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: HPAScaleToZero=true,MutatingAdmissionPolicy=true
      runtime-config: admissionregistration.k8s.io/v1beta1=true
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1alpha1
          kind: PodSecurityConfiguration
          defaults:
            enforce: privileged
            enforce-version: latest
            audit: privileged
            audit-version: latest
            warn: privileged
            warn-version: latest
          exemptions:
            namespaces:
              - kube-system
            runtimeClasses: []
            usernames: []
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:{{ kubernetes_version }}
    extraArgs:
      bind-address: 0.0.0.0
      feature-gates: HPAScaleToZero=true
  coreDNS:
    disabled: true
  etcd:
    ca:
      crt: op://k8s/talos/CLUSTER_ETCD_CA_CRT
      key: op://k8s/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - "10.13.17.0/24"
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:{{ kubernetes_version }}
  scheduler:
    image: registry.k8s.io/kube-scheduler:{{ kubernetes_version }}
    extraArgs:
      bind-address: 0.0.0.0
---
# was: machine.nodeLabels (merges into the base KubeNodeConfig). The v1alpha1
# bridge added the control-plane role label automatically; KubeNodeConfig does not.
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
  node.kubernetes.io/exclude-from-external-load-balancers: ""
---
# was: machine.features.kubernetesTalosAPIAccess (used by ARC runners and tuppr)
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - actions-runner-system
  - system-upgrade
---
# Layer 2 VIP for the control-plane endpoint (floats across control-plane nodes)
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.13.17.17
link: bond0
