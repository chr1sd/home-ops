---
# Base machine config applied to every node.
# Secrets are 1Password references resolved by `op inject` at render time.
# {{ schematic }} is passed via `minijinja-cli -D schematic=<id>`.
version: v1alpha1
debug: false
persist: true
machine:
  token: op://k8s/talos/MACHINE_TOKEN
  ca:
    crt: op://k8s/talos/MACHINE_CA_CRT
  certSANs:
    - "127.0.0.1"
    - "10.13.17.17"
  install:
    image: factory.talos.dev/metal-installer/{{ schematic }}:v1.14.0
    wipe: false
    grubUseUKICmdline: true
  kubelet:
    # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
    image: ghcr.io/siderolabs/kubelet:v1.36.3
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      serializeImagePulls: false
    nodeIP:
      validSubnets:
        - "10.13.17.0/24"
  network:
    disableSearchDomain: true
    nameservers:
      - "10.13.17.1"
      - "1.1.1.1"
  files:
    - op: create
      path: /etc/cri/conf.d/20-customization.part
      content: |
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
        [plugins."io.containerd.cri.v1.runtime"]
          device_ownership_from_security_context = true
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        nconnect=16
        noatime=True
        rsize=4194304
        wsize=4194304
  time:
    disabled: false
    servers:
      - 162.159.200.1
      - 162.159.200.123
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.default_qdisc: "fq"
    net.core.netdev_max_backlog: "50000"
    net.core.rmem_max: "67108864"
    net.core.somaxconn: "65535"
    net.core.wmem_max: "67108864"
    net.ipv4.ip_local_port_range: "1024 65535"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv4.ping_group_range: "0 2147483647"
    net.ipv4.tcp_congestion_control: "bbr"
    net.ipv4.tcp_fastopen: "3"
    net.ipv4.tcp_fin_timeout: "15"
    net.ipv4.tcp_max_syn_backlog: "65535"
    net.ipv4.tcp_mtu_probing: "1"
    net.ipv4.tcp_notsent_lowat: "131072"
    net.ipv4.tcp_rmem: "4096 131072 67108864"
    net.ipv4.tcp_slow_start_after_idle: "0"
    net.ipv4.tcp_tw_reuse: "1"
    net.ipv4.tcp_window_scaling: "1"
    net.ipv4.tcp_wmem: "4096 16384 67108864"
    sunrpc.tcp_max_slot_table_entries: "128"
    sunrpc.tcp_slot_table_entries: "128"
    user.max_user_namespaces: "11255"
  features:
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true
cluster:
  id: op://k8s/talos/CLUSTER_ID
  secret: op://k8s/talos/CLUSTER_SECRET
  token: op://k8s/talos/CLUSTER_TOKEN
  ca:
    crt: op://k8s/talos/CLUSTER_CA_CRT
  clusterName: kubernetes
  controlPlane:
    endpoint: https://10.13.17.17:6443
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - "10.244.0.0/16"
    serviceSubnets:
      - "10.96.0.0/12"
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service: {}
---
# Bond members: alias both Intel X710 SFP+ ports (i40e driver) as sfp0/sfp1,
# independent of predictable interface names. The MS01 onboard 2.5GbE NICs use
# the igc driver and are left unconfigured. `%d` enumerates the matched links.
apiVersion: v1alpha1
kind: LinkAliasConfig
name: sfp%d
selector:
  match: link.driver == "i40e"
---
# 2×10GbE LACP bond (802.3ad) across the two X710 ports. Requires each node's two
# switch ports configured as an LACP LAG (enable LACP fallback/individual mode so
# a single link is reachable in maintenance mode before the bond negotiates).
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - sfp0
  - sfp1
bondMode: 802.3ad
lacpRate: fast
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer3+4
mtu: 9000
---
# Tagged VLAN 87 on the bond (cluster subnet 10.13.17.0/24 rides untagged on bond0;
# per-node addresses live in nodes/controlplane/<node>.yaml.j2).
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.87
vlanID: 87
parent: bond0
mtu: 9000
---
# Ring-buffer tuning on the two X710 SFP+ ports (i40e), max 8160 (was 512).
# Explicit names: predictable + identical across the MS01s. EthernetConfig
# doesn't document link-alias support, so it targets the physical interfaces.
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f0np0
rings:
  rx: 8160
  tx: 8160
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp2s0f1np1
rings:
  rx: 8160
  tx: 8160
